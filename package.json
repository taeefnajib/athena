{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --kill-others-on-fail --names \"backend,frontend\" --prefix-colors \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uv --directory backend run uvicorn athena.main:app --reload --port 8001",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd frontend && npm install",
    "setup:backend": "cd backend && uv pip install -e .",
    "stop": "npx --yes kill-port 8000 8001 5173"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
